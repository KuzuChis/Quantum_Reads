<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/signup_buku"
        android:layout_width="88dp"
        android:layout_height="91dp"
        android:layout_marginTop="4dp"
        app:layout_constraintHorizontal_bias="0.052"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/login_buku" />

    <TextView
        android:id="@+id/judul_editProfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="QUANTUM READS"
        android:textColor="@color/white"
        android:textSize="33dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/signup_buku"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edit_namalengkap_editProfil"
        android:layout_width="294dp"
        android:layout_height="37dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/customedittext"
        android:drawableStart="@drawable/username"
        android:drawablePadding="13dp"
        android:elevation="3dp"
        android:ems="10"
        android:inputType="text"
        android:paddingStart="10dp"
        android:hint="Nama Lengkap"
        android:textColorHint="#aeaeae"
        android:textColor="@color/white"
        android:textSize="12dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/judulform_editProfil"
        app:layout_constraintStart_toStartOf="@+id/judulform_editProfil"
        app:layout_constraintTop_toBottomOf="@+id/judulform_editProfil" />

    <EditText
        android:id="@+id/editemail_editProfil"
        android:layout_width="294dp"
        android:layout_height="37dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/customedittext"
        android:drawableStart="@drawable/gmail"
        android:drawablePadding="13dp"
        android:elevation="3dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:paddingStart="10dp"
        android:hint="Gmail"
        android:textColorHint="#aeaeae"
        android:textColor="@color/white"
        android:textSize="12dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/edit_namalengkap_editProfil"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/edit_namalengkap_editProfil"
        app:layout_constraintTop_toBottomOf="@+id/edit_namalengkap_editProfil" />

    <EditText
        android:id="@+id/edittelepon_editProfil"
        android:layout_width="294dp"
        android:layout_height="37dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/customedittext"
        android:drawableStart="@drawable/phone"
        android:drawablePadding="13dp"
        android:elevation="3dp"
        android:ems="10"
        android:inputType="phone"
        android:paddingStart="10dp"
        android:hint="Telepon"
        android:textColorHint="#aeaeae"
        android:textColor="@color/white"
        android:textSize="12dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/editemail_editProfil"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/editemail_editProfil"
        app:layout_constraintTop_toBottomOf="@+id/editemail_editProfil" />

    <EditText
        android:id="@+id/editalamat_editProfil"
        android:layout_width="294dp"
        android:layout_height="37dp"
        android:layout_marginTop="21dp"
        android:background="@drawable/customedittext"
        android:drawableStart="@drawable/alamat"
        android:drawablePadding="13dp"
        android:elevation="3dp"
        android:ems="10"
        android:inputType="textPostalAddress"
        android:paddingStart="10dp"
        android:hint="Alamat"
        android:textColorHint="#aeaeae"
        android:textColor="@color/white"
        android:textSize="12dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/edittelepon_editProfil"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/edittelepon_editProfil"
        app:layout_constraintTop_toBottomOf="@+id/edittelepon_editProfil" />

    <TextView
        android:id="@+id/judulform_editProfil"
        android:layout_width="166dp"
        android:layout_height="27dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/customedittext"
        android:drawablePadding="13dp"
        android:elevation="3dp"
        android:paddingStart="10dp"
        android:text=" EDIT PROFILE"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/judul_editProfil" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/app_submit"
        android:layout_width="91dp"
        android:layout_height="36dp"
        android:layout_marginTop="104dp"
        android:background="@drawable/custom_btn"
        android:elevation="3dp"
        android:text="confirm"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/editalamat_editProfil"
        app:layout_constraintHorizontal_bias="0.891"
        app:layout_constraintStart_toStartOf="@+id/editalamat_editProfil"
        app:layout_constraintTop_toBottomOf="@+id/editalamat_editProfil" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/app_cancel"
        android:layout_width="91dp"
        android:layout_height="36dp"
        android:layout_marginTop="104dp"
        android:background="@drawable/custom_cancel_btn"
        android:elevation="3dp"
        android:text="cancel"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/editalamat_editProfil"
        app:layout_constraintHorizontal_bias="0.108"
        app:layout_constraintStart_toStartOf="@+id/editalamat_editProfil"
        app:layout_constraintTop_toBottomOf="@+id/editalamat_editProfil" />


</androidx.constraintlayout.widget.ConstraintLayout>