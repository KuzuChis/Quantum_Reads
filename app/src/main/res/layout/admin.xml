<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple"
    tools:context=".MainActivity">


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="129dp"
        android:layout_height="131dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/login_buku" />

    <TextView
        android:id="@+id/textView_admin"
        android:layout_width="222dp"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:text="Selamat Datang, Admin"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_lihatbuku"
        android:layout_width="251dp"
        android:layout_height="100dp"
        android:layout_marginStart="26dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/custom_pinjam_btn"
        android:elevation="3dp"
        android:ems="10"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:padding="13dp"
        android:text="[LIHAT BUKU]"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/imageViewbuku_admin"
        app:layout_constraintTop_toBottomOf="@+id/textView_admin" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_lihatmember"
        android:layout_width="251dp"
        android:layout_height="100dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/custom_pinjam_btn"
        android:elevation="3dp"
        android:ems="10"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:padding="13dp"
        android:text="[LIHAT MEMBER]"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/imageViewmember_admin"
        app:layout_constraintTop_toBottomOf="@+id/btn_lihatbuku" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_tglpinjam"
        android:layout_width="251dp"
        android:layout_height="100dp"
        android:layout_marginStart="29dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/custom_pinjam_btn"
        android:elevation="3dp"
        android:ems="10"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:padding="13dp"
        android:text="[TANGGAL PEMINJAMAN]\n dan \n[TANGGAL PENGEMBALIAN]"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/imageViewtgl_admin"
        app:layout_constraintTop_toBottomOf="@+id/btn_lihatmember" />

    <ImageView
        android:id="@+id/imageViewmember_admin"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/customedittext"
        android:padding="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageViewbuku_admin"
        app:srcCompat="@drawable/members" />

    <ImageView
        android:id="@+id/imageViewtgl_admin"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/customedittext"
        android:padding="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageViewmember_admin"
        app:srcCompat="@drawable/calendar" />

    <ImageView
        android:id="@+id/imageViewbuku_admin"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="76dp"
        android:background="@drawable/customedittext"
        android:padding="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:srcCompat="@drawable/buku" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/LogoutAdmin"
        android:layout_width="91dp"
        android:layout_height="36dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/custom_cancel_btn"
        android:elevation="3dp"
        android:text="logout"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>